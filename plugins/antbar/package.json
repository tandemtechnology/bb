{
  "name": "bb-plugin-antbar",
  "version": "0.1.0",
  "description": "AntBar combines an attention Inbox with named thread groups, a board, and thread filing tools.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tandemtechnology/bb.git",
    "directory": "plugins/antbar"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "emoji.ts",
    "inbox.ts",
    "migration.ts",
    "components",
    "lib",
    "hooks",
    "README.md"
  ],
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "AntBar",
    "description": "An attention Inbox above project and group organization, with a board and thread filing tools.",
    "branding": {
      "icon": "PanelLeft"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../scripts/build-official-plugins.mjs antbar",
    "test": "node --experimental-strip-types --test emoji.test.ts inbox.test.ts migration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bb/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.19",
